NODE_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgres://wander:wander@localhost:5432/wandermatch
PG_POOL_MAX=15
PG_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Consensus planner. Without this the tie-break falls back to
# "earliest proposal wins" and the UI says so explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_MS=20000

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wandermatch-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_PHOTO_BYTES=15728640

FACE_SERVICE_URL=http://localhost:8001
FACE_SERVICE_TOKEN=dev-face-token
FACE_ENABLED=true
FACE_TIMEOUT_MS=60000
